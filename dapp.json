{
  "description": "Leaderboard of who invited who, with join counts per link.",
  "secrets": [],
  "tests": [
    {
      "id": "board.leaderboard",
      "name": "Leaderboard renders with seeded inviters",
      "path": "/",
      "expectText": "staging-demo-alice",
      "visual": true,
      "impact": ["public/index.html", "server.js"]
    },
    {
      "name": "My invites tab is the active view",
      "path": "/?tab=mine",
      "expectSelector": "#view-mine:not(.hidden)"
    },
    {
      "id": "mine.demo-states",
      "name": "My invites demo shows live countdown and copy button",
      "path": "/?tab=mine&demo=1",
      "expectSelector": "[data-countdown]",
      "expectText": "Expires in",
      "visual": true,
      "impact": ["public/index.html"]
    },
    {
      "name": "Create link form opens",
      "path": "/?tab=mine&create=1",
      "expectSelector": "#overlay:not(.hidden)"
    }
  ]
}